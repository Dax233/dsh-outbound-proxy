# DeepSeek Harness outbound proxy -- local Clash/mihomo mixed port.
# Copy this file to:  %USERPROFILE%\.dsh\.env
# Set both URLs to the mixed/HTTP port your proxy client listens on:
#   Clash for Windows default: 7890    Clash Verge default: 7897
#   (the plugin's own default, used only when these are absent, is 7890)
# Only this Harness-home file may set proxy names; a project .env may not.
# Read once by the launcher at Host start (restart the desktop app after editing).
# The outbound-proxy plugin follows these values unless its row sets proxyUrl.
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=deepseek.com,opencode.ai,localhost,127.0.0.1,::1
